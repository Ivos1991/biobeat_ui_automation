# Use the same credential variable names locally that CI uses in GitHub Actions secrets.
WEB_BASE_URL=https://bpm-demo.eu.bio-beat.cloud
BIOBEAT_USERNAME=
BIOBEAT_PASSWORD=
BROWSER=chromium
HEADLESS=true
SLOW_MO_MS=0
DEFAULT_TIMEOUT_MS=15000
EXPECT_TIMEOUT_MS=10000
NAVIGATION_TIMEOUT_MS=30000
BROWSER_EVIDENCE_MODE=failure_only
IGNORE_HTTPS_ERRORS=true
ENABLED_PLUGINS=session_logger,allure_evidence
FRAMEWORK_ENV=local
LOG_LEVEL=INFO
ARTIFACT_DIR=artifacts
LOGIN_PATH=/login
